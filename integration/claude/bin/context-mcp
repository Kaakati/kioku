#!/usr/bin/env ruby
# frozen_string_literal: true

# context-mcp: the MCP stdio server exposing the six Kioku tools.
#
# STDOUT is reserved for MCP protocol messages. Every diagnostic goes to
# STDERR. This process holds no storage authority: it forwards each call to
# context-agent over the private Unix socket and renders the response.

$stdout.sync = true
$stderr.sync = true

require_relative "../lib/kioku"
require_relative "../lib/kioku/mcp/runner"

exit(Kioku::Mcp::Runner.new.run)
