#!/usr/bin/env ruby
# frozen_string_literal: true

# context-agent: the persistent host service.
#
# It owns host filesystem authority -- project/root binding, path resolution
# inside approved roots, source reads and SHA-256 hashing -- plus the durable
# bounded spool. It listens on the private Unix socket at KIOKU_SOCKET_PATH and
# holds the authenticated loopback connection to the core, which is the only
# path by which the core can ask the host to validate source.

$stdout.sync = true
$stderr.sync = true

require_relative "../lib/kioku"
require_relative "../lib/kioku/agent/cli"

exit(Kioku::Agent::Cli.new(ARGV).run)
