#!/usr/bin/env ruby
# frozen_string_literal: true

# contextctl: hook dispatch and operator commands.
#
# STDOUT carries the hook event's own output contract and nothing else.
# Diagnostics go to STDERR. A hook invocation always exits 0, so an unreachable
# Kioku core can never block or fail a Claude Code session.

$stdout.sync = true
$stderr.sync = true

require_relative "../lib/kioku"
require_relative "../lib/kioku/cli"

exit(Kioku::Cli.new(ARGV).run)
