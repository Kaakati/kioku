{
  "_comment": "Kioku hook registration template for Claude Code settings. Every event runs `contextctl hook`, which reads bounded stdin, forwards the event to the host agent and exits well inside the one-second outer guard. A hook that cannot reach the agent returns without enhancement and never blocks the turn.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "contextctl hook", "timeout": 1 }] }]
  }
}
