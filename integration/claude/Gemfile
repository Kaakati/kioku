# frozen_string_literal: true

source "https://rubygems.org"

ruby ">= 3.2"

# The official Ruby MCP SDK. context-mcp uses MCP::Server, MCP::Tool and
# MCP::Server::Transports::StdioTransport; it does not hand-roll JSON-RPC.
gem "mcp", "1.5.1"

# Ruby 3.4 demoted base64 from a default gem to a bundled one, and mcp 1.5.1
# does not declare it in its gemspec. Without this pin the adapter can fail to
# start on a host where the bundled gem was pruned.
gem "base64", "~> 0.2"

group :test do
  gem "minitest", "~> 5.25"
end
