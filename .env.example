# Kioku — example environment. Copy to `.env` and fill in the three secrets.
#
#   cp .env.example .env
#
# `.env` is gitignored; this example file is committed. Every value below is a
# placeholder, not a credential. Generate real secrets locally, e.g.:
#
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
#
# Compose reads this file from the same directory as compose.yml.


# -----------------------------------------------------------------------------
# PostgreSQL (service `db`, paradedb/paradedb:0.25.9-pg18)
# -----------------------------------------------------------------------------

# Database superuser created by the image on first boot of an empty volume.
# Changing this after the volume is initialised has no effect — the volume must
# be recreated. Default when unset: kioku
POSTGRES_USER=kioku

# REQUIRED, no default. Compose refuses to start without it. Replace before use.
POSTGRES_PASSWORD=change-me-postgres-password

# Database created on first boot of an empty volume. Also the database the
# `migrate` service prepares. Default when unset: kioku_development
POSTGRES_DB=kioku_development

# Connection string used by migrate, api and worker.
#
# Leave this commented out. compose.yml composes it from POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB above, which removes the classic failure where
# the password here drifts out of sync with the password the database was created
# with. Set it only to point the backend at a PostgreSQL outside this stack; it
# must then be a PostgreSQL 18 server with the `vector` and `pg_search` extensions
# available, and the host must be reachable from inside the Compose network
# (`localhost` there means the container, not your machine).
#
# Composed value: postgres://kioku:<POSTGRES_PASSWORD>@db:5432/kioku_development
#DATABASE_URL=postgres://kioku:change-me-postgres-password@db:5432/kioku_development


# -----------------------------------------------------------------------------
# Redis (service `redis`, redis:8.10.1-trixie) — Sidekiq job transport only.
# -----------------------------------------------------------------------------

# REQUIRED, no default. Becomes the server's `requirepass` and is used by the
# container healthcheck. Replace before use.
REDIS_PASSWORD=change-me-redis-password

# Connection string used by api and worker. Leave commented out for the same
# reason as DATABASE_URL: compose.yml composes it from REDIS_PASSWORD.
# Database index 0 is the Sidekiq queue instance. Do not point application caching
# at it — Redis here runs with maxmemory-policy noeviction on purpose.
#
# Composed value: redis://:<REDIS_PASSWORD>@redis:6379/0
#REDIS_URL=redis://:change-me-redis-password@redis:6379/0


# -----------------------------------------------------------------------------
# Rails (services `migrate`, `api`, `worker`)
# -----------------------------------------------------------------------------

# Rails environment for all three backend services. `development` is the default
# and matches the stock image, which installs every bundle group so the Minitest
# suite can run in the container.
#
# Setting this to `production` additionally requires building the image with
# --build-arg BUNDLE_WITHOUT=development:test and providing SECRET_KEY_BASE.
RAILS_ENV=development

# Puma's thread count and, through database.yml, the Active Record connection
# pool size. Budget this against PostgreSQL's connection limit together with the
# worker's Sidekiq concurrency (plan §4.2) — api threads + worker concurrency +
# headroom must stay under max_connections.
RAILS_MAX_THREADS=5


# -----------------------------------------------------------------------------
# Kioku host integration
# -----------------------------------------------------------------------------

# REQUIRED, no default. Shared secret authenticating the host agent's loopback
# bridge connection to the Rails API on 127.0.0.1:7310. The same value must be
# configured for the host adapter in ./integration/claude. Replace before use.
KIOKU_BRIDGE_TOKEN=change-me-bridge-token

# Filesystem root, inside the api and worker containers, for retained evidence
# objects. Backed by the shared `objects_data` named volume and owned by the
# image's non-root `kioku` user (uid/gid 1000). Change this only if you also
# change the volume mount target in compose.yml.
KIOKU_OBJECT_ROOT=/var/lib/kioku/objects

# HOST-SIDE ONLY — this is deliberately not passed into any container.
#
# Private Unix socket where the host `context-agent` listens for `contextctl` and
# `context-mcp`. It stays on the host and is never mounted through Docker Desktop
# (plan §3); containers reach nothing through it. It is listed here because the
# host adapter in ./integration/claude reads the same .env file.
KIOKU_SOCKET_PATH=~/.kioku/run/agent.sock
