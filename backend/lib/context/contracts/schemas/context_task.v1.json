{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/context_task.v1.json",
  "title": "context_task request",
  "description": "A discriminated eight-operation schema, not an arbitrary command or SQL interface. A task always resolves to exactly one project. There is no model-writable pass operation: normalized observations enter only through authenticated ingest.",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "envelope.v1.json#/$defs/request_envelope" },
    "op": {
      "type": "string",
      "enum": ["get", "set_contract", "record_claim", "propose", "plan_check", "assess", "checkpoint", "close"]
    },
    "task_key": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "token_budget": { "type": ["integer", "null"], "minimum": 1 },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["contract", "criteria", "claims", "candidates", "checks", "observations", "assessments", "checkpoints", "receipts"]
      }
    },
    "at_contract_revision": { "type": ["integer", "null"], "minimum": 1 },
    "limit": { "type": ["integer", "null"], "minimum": 1, "maximum": 200 },
    "cursor": { "type": ["string", "null"], "maxLength": 2048 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "scope": { "$ref": "#/$defs/task_scope" },
    "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" }, "maxItems": 100 },
    "origin_event_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
    "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
    "known_exclusions": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
    "state": { "$ref": "#/$defs/working_state" },
    "contract_revision": { "type": "integer", "minimum": 1 },
    "expected_contract_revision": { "type": "integer", "minimum": 1 },
    "statement": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "materiality": { "type": "string", "enum": ["material", "informational"] },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "envelope.v1.json#/$defs/typed_handle" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "supporting_evidence": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/evidence_link" }, "maxItems": 50 },
    "conflicting_evidence": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/evidence_link" }, "maxItems": 50 },
    "alternative_explanations": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "contradiction_conditions": { "type": ["string", "null"], "maxLength": 4096 },
    "assessment": { "$ref": "#/$defs/attributed_assessment" },
    "proposal": { "$ref": "#/$defs/proposal" },
    "risks": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "verdict": { "type": "string", "enum": ["open", "selected", "rejected"] },
    "retry_conditions": { "type": ["string", "null"], "maxLength": 4096 },
    "supersedes_candidate_version_key": { "type": ["string", "null"], "maxLength": 128 },
    "origin": { "type": "string", "enum": ["local_case", "external_research", "model_synthesis"] },
    "criterion_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "check_kind": { "type": "string", "enum": ["test", "inspection", "analysis", "review"] },
    "expected_snapshot_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expected_environment_fingerprint": { "type": "string", "minLength": 1, "maxLength": 512 },
    "verifier_digest": { "type": "string", "minLength": 1, "maxLength": 512 },
    "minimum_input_assurance": { "type": "string", "enum": ["immutable_snapshot", "observed_bookends"] },
    "definition": { "$ref": "#/$defs/versioned_json" },
    "candidate_version_key": { "type": ["string", "null"], "maxLength": 128 },
    "expected_distinguishing_outcomes": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "priority_factors": { "$ref": "#/$defs/priority_factors" },
    "criterion_keys": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "snapshot_ref": { "type": ["string", "null"], "maxLength": 512 },
    "environment_fingerprint": { "type": ["string", "null"], "maxLength": 512 },
    "include_evidence": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "open_questions": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "next_check_ref": { "type": ["string", "null"], "maxLength": 128 },
    "evidence": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/evidence_link" }, "maxItems": 50 },
    "persist_as_memory": {
      "type": "boolean",
      "default": true,
      "description": "Writes a task_checkpoint memory revision in the same transaction through the same Remember path."
    },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expected_heads": {
      "type": "object",
      "description": "Heads as observed by the caller: contract, criteria, claims, candidates, checks, source_epoch, policy_generation, deletion_epoch.",
      "additionalProperties": { "type": ["integer", "string"] }
    },
    "closing_note": { "type": ["string", "null"], "maxLength": 4096 },
    "limitations_acknowledged": { "type": "array", "items": { "type": "string" }, "maxItems": 32 }
  },
  "required": ["envelope", "op"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "op": { "const": "get" } }, "required": ["op"] },
      "then": { "required": ["task_key"] } },
    { "if": { "properties": { "op": { "const": "set_contract" } }, "required": ["op"] },
      "then": { "required": ["objective", "scope", "criteria", "origin_event_ref"] } },
    { "if": { "properties": { "op": { "const": "record_claim" } }, "required": ["op"] },
      "then": { "required": ["task_key", "contract_revision", "statement", "materiality", "subjects"] } },
    { "if": { "properties": { "op": { "const": "propose" } }, "required": ["op"] },
      "then": { "required": ["task_key", "contract_revision", "proposal"] } },
    { "if": { "properties": { "op": { "const": "plan_check" } }, "required": ["op"] },
      "then": { "required": ["task_key", "contract_revision", "criterion_key", "check_kind", "expected_snapshot_ref", "expected_environment_fingerprint", "verifier_digest", "minimum_input_assurance", "definition"] } },
    { "if": { "properties": { "op": { "const": "assess" } }, "required": ["op"] },
      "then": { "required": ["task_key", "expected_contract_revision"] } },
    { "if": { "properties": { "op": { "const": "checkpoint" } }, "required": ["op"] },
      "then": { "required": ["task_key", "contract_revision", "state", "summary"] } },
    { "if": { "properties": { "op": { "const": "close" } }, "required": ["op"] },
      "then": { "required": ["task_key", "expected_contract_revision", "receipt_id", "expected_heads"] } }
  ],
  "$defs": {
    "working_state": {
      "type": "string",
      "enum": ["investigating", "implementing", "checking", "blocked", "interrupted"],
      "description": "completed_in_scope is not an accepted checkpoint state; only close can move the projection there."
    },
    "projection_state": {
      "type": "string",
      "enum": ["investigating", "implementing", "checking", "blocked", "completed_in_scope", "interrupted"]
    },
    "task_scope": {
      "type": "object",
      "properties": {
        "project_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository_keys": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "worktree_keys": { "type": "array", "items": { "type": "string" }, "maxItems": 32 }
      },
      "required": ["project_key"],
      "additionalProperties": false
    },
    "versioned_json": {
      "type": "object",
      "properties": { "schema_version": { "type": "string" } },
      "required": ["schema_version"]
    },
    "criterion": {
      "type": "object",
      "description": "Explicit user requirements stay distinct from agent-inferred criteria: authority is recorded per requirement. An empty criteria list is legal and leaves the task unassessable, never vacuously complete.",
      "properties": {
        "criterion_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "required": { "type": "boolean" },
        "authority": { "type": "string", "enum": ["user", "assistant", "system"] },
        "verification_policy": { "$ref": "#/$defs/versioned_json" }
      },
      "required": ["criterion_key", "description", "required", "authority", "verification_policy"],
      "additionalProperties": false
    },
    "attributed_assessment": {
      "type": "object",
      "description": "An assessment supplied by a model actor is recorded as an attributed judgment with its evaluator, never as a verified fact.",
      "properties": {
        "support": { "type": "string", "enum": ["unassessed", "supported_in_scope", "contradicted", "inconclusive"] },
        "evaluator": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 8192 }
      },
      "required": ["support", "evaluator"],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "description": "Candidate versions are immutable: any content change mints a new candidate_version_key rather than editing one.",
      "properties": {
        "problem": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "expected_effect": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "preconditions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["framework_version", "dependency", "schema", "state", "workload", "platform", "constraint"]
              },
              "detail": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "required": ["kind", "detail"],
            "additionalProperties": false
          }
        },
        "change_scope": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/typed_handle" }, "maxItems": 50 },
        "discriminating_check": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["problem", "mechanism", "expected_effect", "preconditions", "change_scope", "discriminating_check"],
      "additionalProperties": false
    },
    "priority_factors": {
      "type": "object",
      "description": "Explicit ordinal fields. No numeric information-gain score is presented as calibrated.",
      "properties": {
        "decisiveness": { "type": "string", "enum": ["low", "medium", "high"] },
        "affected_requirement": { "type": "string", "maxLength": 128 },
        "feasibility": { "type": "string", "enum": ["low", "medium", "high"] },
        "expected_latency_ms": { "type": "integer", "minimum": 0 },
        "expected_token_cost": { "type": "integer", "minimum": 0 },
        "execution_scope": { "type": "string", "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "observation_rejection_code": {
      "type": "string",
      "enum": [
        "snapshot_mismatch", "environment_mismatch", "verifier_digest_mismatch",
        "insufficient_input_assurance", "zero_executed_cases", "scope_mismatch",
        "deleted", "unknown_outcome", "stale_contract_revision"
      ]
    },
    "blocker_kind": {
      "type": "string",
      "enum": ["material_claim_conflict", "unresolved_requirement", "open_dispute", "unavailable_evidence"]
    }
  }
}
