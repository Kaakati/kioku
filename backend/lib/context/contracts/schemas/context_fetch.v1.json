{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/context_fetch.v1.json",
  "title": "context_fetch request",
  "description": "Return the exact bytes, ranges or revisions behind already-identified handles in bounded batches, re-authorizing scope and re-checking deletion state on every request. An object ID or content hash grants no access by itself.",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "envelope.v1.json#/$defs/request_envelope" },
    "handles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/fetch_handle" }
    },
    "ranges": {
      "type": "object",
      "description": "Per-handle sub-ranges keyed by handle key. Out-of-range requests are truncated and reported in coverage, never silently clamped.",
      "additionalProperties": { "$ref": "#/$defs/range" }
    },
    "max_bytes_per_handle": { "type": "integer", "minimum": 1, "default": 65536 },
    "token_budget": { "type": ["integer", "null"], "minimum": 1, "default": 1500 },
    "format": { "type": "string", "enum": ["text", "structured"], "default": "text" },
    "include_provenance": { "type": "boolean", "default": true },
    "revalidate_source": {
      "type": "boolean",
      "default": true,
      "description": "Batch host check of selected dependencies under the caller deadline. Applies to source_range handles."
    },
    "as_of_revision": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Pin a historical revision. Historical content is always labelled applicability=historical and can never acquire a current-source label."
    },
    "cursor": { "type": ["string", "null"], "maxLength": 2048 }
  },
  "required": ["envelope", "handles"],
  "additionalProperties": false,
  "$defs": {
    "fetch_handle": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "memory_revision", "global_record_revision", "evidence", "object",
            "source_range", "commit", "diff", "observation", "report", "receipt", "packet"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": ["integer", "null"], "minimum": 1 }
      },
      "required": ["kind", "key"],
      "additionalProperties": false
    },
    "range": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "byte_start": { "type": "integer", "minimum": 0 },
            "byte_end": { "type": "integer", "minimum": 0 }
          },
          "required": ["byte_start", "byte_end"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "line_start": { "type": "integer", "minimum": 1 },
            "line_end": { "type": "integer", "minimum": 1 }
          },
          "required": ["line_start", "line_end"],
          "additionalProperties": false
        }
      ]
    },
    "unavailable_reason": {
      "type": "string",
      "enum": ["deleted", "expired", "purged", "redacted", "handle_unresolved"]
    },
    "independence": { "type": "string", "enum": ["independent", "shared_lineage", "unknown"] },
    "lineage_state": { "type": "string", "enum": ["root", "known", "unresolved"] }
  }
}
