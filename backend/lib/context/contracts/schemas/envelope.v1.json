{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/envelope.v1.json",
  "title": "kioku.tool.v1 common envelope",
  "description": "Frozen Phase 0 envelope (Plan 6.1). Request and response envelopes plus the shared label vocabulary. Data file: read through Context::Contracts, never autoloaded.",
  "type": "object",
  "x-kioku": {
    "contract_id": "kioku.tool.v1",
    "deadline_policy": {
      "note": "Relative budgets in milliseconds, clamped per tool. Inherited Plan 10 targets, unmeasured for Ruby/Rails/PostgreSQL. Ops not listed individually fall back to the tool entry.",
      "fallback": { "default_ms": 5000, "cap_ms": 15000 },
      "tools": {
        "context_search": { "default_ms": 3000, "cap_ms": 10000 },
        "context_fetch": { "default_ms": 5000, "cap_ms": 15000 },
        "context_related": { "default_ms": 3000, "cap_ms": 10000 },
        "context_remember": { "default_ms": 5000, "cap_ms": 15000 },
        "context_feedback": { "default_ms": 3000, "cap_ms": 10000 },
        "context_task": { "default_ms": 5000, "cap_ms": 15000 },
        "context_task.get": { "default_ms": 3000, "cap_ms": 10000 },
        "context_task.assess": { "default_ms": 10000, "cap_ms": 30000 },
        "context_task.close": { "default_ms": 10000, "cap_ms": 30000 }
      }
    },
    "core_derived_fields": [
      "authority",
      "actor_principal_id",
      "origin_role",
      "agent_key",
      "attribution_state",
      "identity_source",
      "saved",
      "generation_vector",
      "server_time"
    ],
    "retrieval_modes": {
      "supported": ["exact", "lexical", "related"],
      "permanently_unsupported": ["semantic", "hybrid"]
    }
  },
  "$defs": {
    "schema_version": { "type": "string", "const": "kioku.tool.v1" },
    "request_id": {
      "type": "string",
      "description": "UUIDv7, caller-generated, unique per attempt. Not an idempotency key.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "rfc3339": { "type": "string", "format": "date-time" },
    "store": {
      "type": "string",
      "enum": ["project", "global", "both"],
      "description": "both is the default retrieval posture. A global operation declares store=global explicitly; it is never reached by omitting project_key."
    },
    "global_category": {
      "type": "string",
      "enum": ["coding_style", "engineering_decision", "architecture", "preferred_library"]
    },
    "source_view": { "type": "string", "enum": ["current_worktree", "commit", "history"] },
    "scope": {
      "type": "object",
      "properties": {
        "store": { "$ref": "#/$defs/store" },
        "project_key": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "repository_key": { "type": ["string", "null"], "maxLength": 128 },
        "worktree_key": { "type": ["string", "null"], "maxLength": 128 },
        "task_key": { "type": ["string", "null"], "maxLength": 128 },
        "cross_project_keys": {
          "type": "array",
          "default": [],
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "global_categories": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/global_category" }
        },
        "source_view": { "$ref": "#/$defs/source_view", "default": "current_worktree" },
        "commit_oid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" }
      },
      "required": ["store"],
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "description": "Hints only. The core records identity_source and leaves attribution_state=unresolved when the join cannot be established.",
      "properties": {
        "session_id": { "type": ["string", "null"] },
        "agent_key": { "type": ["string", "null"] },
        "provider_agent_id": { "type": ["string", "null"] },
        "parent_agent_key": { "type": ["string", "null"] },
        "agent_run_id": { "type": ["string", "null"] },
        "prompt_id": { "type": ["string", "null"] },
        "tool_use_id": { "type": ["string", "null"] },
        "worktree_id": { "type": ["string", "null"] },
        "context_epoch": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "request_digest": {
      "type": "string",
      "description": "SHA-256 over the canonicalized request body excluding request_id, deadline_ms and correlation. Digest input includes project_key.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "typed_handle": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "memory_key", "memory_revision", "global_record_revision", "task_key",
            "evidence", "evidence_key", "object", "object_key", "event_key",
            "source_range", "symbol_key", "path", "commit", "diff", "observation",
            "report", "receipt", "packet", "candidate_version_key", "error_signature",
            "identifier"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": ["integer", "null"], "minimum": 1 }
      },
      "required": ["kind", "key"],
      "additionalProperties": false
    },
    "evidence_relation": { "type": "string", "enum": ["supports", "contradicts", "context"] },
    "evidence_link": {
      "type": "object",
      "properties": {
        "ref": { "$ref": "#/$defs/typed_handle" },
        "relation": { "$ref": "#/$defs/evidence_relation" }
      },
      "required": ["ref", "relation"],
      "additionalProperties": false
    },
    "evidence_rejection_reason": {
      "type": "string",
      "enum": ["scope_mismatch", "unavailable", "deleted", "anchor_invalid", "not_found"]
    },
    "authority": {
      "type": "string",
      "enum": ["user", "assistant", "tool", "system", "imported"],
      "description": "Core-derived from origin_role and transport. A caller-supplied value is rejected with kioku.invalid_request."
    },
    "lifecycle": { "type": "string", "enum": ["proposed", "active", "superseded", "retracted"] },
    "availability": { "type": "string", "enum": ["available", "redacted", "missing", "expired"] },
    "applicability": {
      "type": "string",
      "enum": ["source_checked", "historical", "stale", "environment_mismatch", "unknown"],
      "description": "source_checked requires a successful host validation inside this request's deadline and describes that instant only."
    },
    "claim_support": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "enum": ["unassessed", "supported_in_scope", "contradicted", "inconclusive"]
        },
        "evaluator": { "type": ["string", "null"] },
        "attributed_at": { "type": ["string", "null"], "format": "date-time" },
        "rationale_ref": { "type": ["string", "null"] }
      },
      "required": ["value"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["complete_for_declared_set", "partial", "unknown"] },
        "declared_input_set": { "type": "object" },
        "counts": {
          "type": "object",
          "properties": {
            "considered": { "type": "integer", "minimum": 0 },
            "returned": { "type": "integer", "minimum": 0 },
            "truncated_at": { "type": ["integer", "null"], "minimum": 0 }
          },
          "required": ["considered", "returned"],
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unindexed_path", "dirty_path", "resolver_hole", "unvalidated_source",
                  "host_disconnected", "traversal_budget", "token_budget", "skipped_file",
                  "unsupported_language", "scope_excluded", "shallow_history", "missing_object"
                ]
              },
              "detail": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "required": ["kind", "detail", "count"],
            "additionalProperties": false
          }
        },
        "omitted_results": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          },
          "required": ["count"],
          "additionalProperties": false
        },
        "completeness_label": {
          "type": "string",
          "const": "known_within_indexed_coverage",
          "description": "Fixed. The contract has no value meaning complete for the repository."
        }
      },
      "required": ["state", "declared_input_set", "counts", "gaps", "completeness_label"],
      "additionalProperties": false
    },
    "generation_vector": {
      "type": "object",
      "properties": {
        "canonical_generation": { "type": "integer", "minimum": 0 },
        "policy_generation": { "type": "integer", "minimum": 0 },
        "global_generation": { "type": "integer", "minimum": 0 },
        "index_generation": { "type": "integer", "minimum": 0 },
        "source_epoch": { "type": "integer", "minimum": 0 },
        "deletion_epoch": { "type": "integer", "minimum": 0 },
        "host_link_state": { "type": "string", "enum": ["connected", "disconnected", "degraded"] },
        "observed_at": { "$ref": "#/$defs/rfc3339" }
      },
      "required": [
        "canonical_generation", "policy_generation", "global_generation",
        "index_generation", "source_epoch", "deletion_epoch", "host_link_state", "observed_at"
      ],
      "additionalProperties": false
    },
    "continuation_handle": {
      "type": ["object", "null"],
      "properties": {
        "cursor": { "type": "string", "maxLength": 2048 },
        "expires_at": { "$ref": "#/$defs/rfc3339" },
        "bound": {
          "type": "object",
          "properties": {
            "scope_digest": { "type": "string" },
            "query_digest": { "type": "string" },
            "filter_digest": { "type": "string" },
            "mode": { "type": "string" },
            "ranking_config_version": { "type": "string" },
            "generation_vector_digest": { "type": "string" }
          },
          "required": ["scope_digest", "query_digest", "filter_digest", "mode"],
          "additionalProperties": false
        },
        "reauthorized_on_use": { "type": "boolean", "const": true },
        "reset_required_reason": {
          "type": ["string", "null"],
          "enum": ["index_changed", "scope_changed", "expired", "deleted", null]
        }
      },
      "required": ["cursor", "expires_at", "bound", "reauthorized_on_use"],
      "additionalProperties": false
    },
    "dispute": {
      "type": "object",
      "properties": {
        "has_open_dispute": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 },
        "objection_handles": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["has_open_dispute", "count", "objection_handles"],
      "additionalProperties": false
    },
    "override_status": {
      "type": "string",
      "enum": ["none", "overridden_in_project", "overriding_global", "mandatory_global"]
    },
    "relevance": {
      "type": ["object", "null"],
      "description": "A BM25 score is a relevance score. It is never claim support and never confidence in truth.",
      "properties": {
        "bm25_score": { "type": "number" },
        "rank": { "type": "integer", "minimum": 1 },
        "tiebreak_key": { "type": "string" }
      },
      "required": ["bm25_score", "rank", "tiebreak_key"],
      "additionalProperties": false
    },
    "token_accounting": {
      "type": "object",
      "properties": {
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "estimator_version": { "type": "string" },
        "budget": { "type": ["integer", "null"], "minimum": 0 },
        "rendered_hash": { "type": "string" }
      },
      "required": ["estimated_tokens", "estimator_version", "budget", "rendered_hash"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "deadline_at": { "$ref": "#/$defs/rfc3339" },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "candidate_limit": { "type": ["integer", "null"], "minimum": 0 },
        "returned": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "token_accounting": { "$ref": "#/$defs/token_accounting" }
      },
      "required": ["deadline_at", "elapsed_ms", "returned", "truncated", "token_accounting"],
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "detail": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "required": ["code", "detail", "count"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success", "partial", "queued", "conflict", "unauthorized_scope",
        "unavailable_source", "evidence_unavailable", "quota_exhausted", "deadline_expired"
      ]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string", "pattern": "^kioku\\.[a-z_]+$" },
        "message": { "type": "string", "description": "Operator-facing, content- and credential-redacted." },
        "retryable": { "type": "boolean" },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "details": { "type": "object" }
      },
      "required": ["code", "message", "retryable", "details"],
      "additionalProperties": false
    },
    "receipt": {
      "type": ["object", "null"],
      "description": "Reads return a prepared-packet receipt; mutations return a canonical commit receipt.",
      "properties": {
        "receipt_id": { "type": "string" },
        "idempotency_key": { "type": ["string", "null"] },
        "request_digest": { "type": ["string", "null"] },
        "committed_at": { "type": ["string", "null"], "format": "date-time" },
        "replayed": { "type": "boolean" },
        "packet_receipt_id": { "type": ["string", "null"] },
        "prepared_at": { "type": ["string", "null"], "format": "date-time" },
        "estimated_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimator_version": { "type": ["string", "null"] },
        "rendered_hash": { "type": ["string", "null"] },
        "emission_status": { "type": ["string", "null"], "enum": ["prepared", "attempted", "observed", null] }
      },
      "additionalProperties": false
    },
    "request_envelope": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "deadline_ms": { "$ref": "#/$defs/deadline_ms" },
        "scope": { "$ref": "#/$defs/scope" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_digest": { "$ref": "#/$defs/request_digest" },
        "expected_revision": { "type": ["integer", "null"], "minimum": 1 },
        "token_budget": { "type": ["integer", "null"], "minimum": 1 },
        "correlation": { "$ref": "#/$defs/correlation" },
        "client": { "$ref": "#/$defs/client" },
        "trace_id": { "type": ["string", "null"] }
      },
      "required": ["schema_version", "request_id", "deadline_ms", "scope"],
      "additionalProperties": false
    },
    "mutation_envelope": {
      "allOf": [
        { "$ref": "#/$defs/request_envelope" },
        { "required": ["idempotency_key", "request_digest"] }
      ]
    },
    "response_envelope": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "status": { "$ref": "#/$defs/status" },
        "error": { "$ref": "#/$defs/error" },
        "data": { "type": ["object", "null"] },
        "generation_vector": { "$ref": "#/$defs/generation_vector" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "continuation": { "$ref": "#/$defs/continuation_handle" },
        "receipt": { "$ref": "#/$defs/receipt" },
        "limits": { "$ref": "#/$defs/limits" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "server_time": { "$ref": "#/$defs/rfc3339" }
      },
      "required": [
        "schema_version", "request_id", "status", "generation_vector",
        "coverage", "limits", "warnings", "server_time"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/request_envelope"
}
