{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/context_search.v1.json",
  "title": "context_search request",
  "description": "Return a bounded, scope-authorized, labeled candidate set without asserting that any candidate is true. mode is the retrieval mechanism; profile is the subject route. semantic and hybrid are permanently unsupported: embeddings, vector search and hybrid search are out of scope, not deferred.",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "envelope.v1.json#/$defs/request_envelope" },
    "mode": {
      "type": "string",
      "enum": ["exact", "lexical", "related"],
      "description": "The only three retrieval mechanisms. mode=solutions is a deprecated alias for {mode:lexical, profile:solutions}."
    },
    "profile": {
      "type": "string",
      "enum": ["mixed", "memory", "code", "evidence", "solutions"],
      "default": "mixed"
    },
    "query": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "envelope.v1.json#/$defs/typed_handle" }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "envelope.v1.json#/$defs/typed_handle" }
    },
    "edge_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/edge_kind" }
    },
    "filters": { "$ref": "#/$defs/filters" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "candidate_limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 40 },
    "expand": {
      "type": "object",
      "properties": {
        "hops": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
        "fanout": { "type": "integer", "minimum": 1, "default": 25 },
        "max_visited_edges": { "type": "integer", "minimum": 1, "default": 200 },
        "edge_kinds": { "type": "array", "items": { "$ref": "#/$defs/edge_kind" }, "maxItems": 8 }
      },
      "additionalProperties": false
    },
    "facets": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": ["kind", "store_kind", "category", "language", "lifecycle", "repository", "author_authority"]
      }
    },
    "highlight": {
      "type": "boolean",
      "default": true,
      "description": "pdb.snippet previews. Automatically disabled with warning highlight_unsupported for fuzzy queries; snippets are previews, never exact evidence handles."
    },
    "include_disputed": {
      "type": "boolean",
      "default": false,
      "description": "When false, factual assertions with an open dispute are suppressed from confident delivery, but governing user decisions, constraints and corrections are still returned with the objection attached."
    },
    "require_source_validation": { "type": "boolean", "default": false },
    "token_budget": { "type": ["integer", "null"], "minimum": 1 },
    "cursor": { "type": ["string", "null"], "maxLength": 2048 },
    "order": { "type": "string", "enum": ["relevance", "recorded_at", "valid_from"], "default": "relevance" }
  },
  "required": ["envelope", "mode"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "mode": { "const": "lexical" } }, "required": ["mode"] }, "then": { "required": ["query"] } },
    { "if": { "properties": { "mode": { "const": "exact" } }, "required": ["mode"] }, "then": { "required": ["keys"] } },
    { "if": { "properties": { "mode": { "const": "related" } }, "required": ["mode"] }, "then": { "required": ["seeds", "edge_kinds"] } }
  ],
  "$defs": {
    "edge_kind": {
      "type": "string",
      "enum": [
        "DEFINES", "IMPORTS", "REFERENCES", "MAY_CALL", "RESOLVES_TO", "IMPLEMENTS",
        "GENERATED_FROM", "CONSUMED_BY", "CONSTRAINS", "PROPOSED_FOR", "REJECTED_IN",
        "SUPERSEDES", "SUPPORTED_BY", "CONTRADICTS", "ASSESSES", "DERIVED_FROM",
        "OBSERVED_FRAME", "EXERCISED"
      ]
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "memory", "global_record", "solution_case", "task", "candidate",
        "observation", "evidence", "code_chunk", "symbol", "commit", "diff"
      ]
    },
    "fallback_reason": {
      "type": "string",
      "enum": [
        "none", "index_generation_lag", "host_disconnected", "traversal_budget_exhausted",
        "token_budget_exhausted", "highlight_unsupported", "pushdown_unsupported_fallback"
      ]
    },
    "facet_basis": { "type": "string", "enum": ["declared_match_set", "bounded_candidate_pool"] },
    "candidate_origin": { "type": "string", "enum": ["local_case", "external_research", "model_proposed"] },
    "filters": {
      "type": "object",
      "properties": {
        "store_kind": { "type": "array", "items": { "type": "string", "enum": ["project", "global"] } },
        "global_categories": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/global_category" } },
        "memory_kinds": {
          "type": "array",
          "items": { "$ref": "context_remember.v1.json#/properties/kind" }
        },
        "lifecycle": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/lifecycle" } },
        "authority": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/authority" } },
        "language": { "type": "array", "items": { "type": "string" } },
        "repository_key": { "type": "array", "items": { "type": "string" } },
        "worktree_key": { "type": "array", "items": { "type": "string" } },
        "task_key": { "type": "array", "items": { "type": "string" } },
        "valid_at": { "type": ["string", "null"], "format": "date-time" },
        "availability": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/availability" } },
        "has_open_dispute": { "type": ["boolean", "null"] },
        "source_view": { "$ref": "envelope.v1.json#/$defs/source_view" },
        "commit_oid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" }
      },
      "additionalProperties": false
    }
  }
}
