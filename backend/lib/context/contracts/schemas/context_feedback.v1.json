{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/context_feedback.v1.json",
  "title": "context_feedback request",
  "description": "Attach an attributed dispute or usefulness signal to one exact memory revision, preserving the objection and its disposition without mutating or cancelling the target. context_feedback never writes a project override: it returns a prepared override request the caller submits through context_remember's override variant.",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "envelope.v1.json#/$defs/mutation_envelope" },
    "target": {
      "type": "object",
      "description": "An exact revision, not a head pointer. A head-only reference returns kioku.invalid_request, because a dispute must name what was actually disputed.",
      "properties": {
        "memory_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "required": ["memory_key", "revision"],
      "additionalProperties": false
    },
    "action": { "type": "string", "enum": ["dispute", "useful", "irrelevant"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "envelope.v1.json#/$defs/evidence_link" }
    },
    "disposition": {
      "type": "string",
      "enum": ["open", "resolved", "withdrawn"],
      "default": "open",
      "description": "Only the authorized party may set resolved or withdrawn. Resolving another principal's dispute returns kioku.authority_violation, and resolving a dispute does not by itself verify its source."
    },
    "feedback_key": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "scope_note": { "type": ["string", "null"], "maxLength": 4096 },
    "proposed_override": {
      "type": ["object", "null"],
      "description": "A routing hint only.",
      "properties": {
        "project_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "replacement_body": { "type": ["string", "null"], "maxLength": 16384 },
        "exclusion": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "validity_interval": {
          "type": "object",
          "properties": {
            "valid_from": { "type": ["string", "null"], "format": "date-time" },
            "valid_until": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "required": ["project_key", "reason"],
      "additionalProperties": false
    },
    "task_key": { "type": ["string", "null"], "maxLength": 128 },
    "context_epoch": { "type": ["string", "null"], "maxLength": 128 }
  },
  "required": ["envelope", "target", "action", "reason"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["feedback_key"], "properties": { "feedback_key": { "type": "string" } } },
      "then": {
        "properties": { "envelope": { "required": ["expected_revision"] } }
      }
    }
  ]
}
