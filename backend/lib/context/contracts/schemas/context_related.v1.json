{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioku.local/contracts/context_related.v1.json",
  "title": "context_related request",
  "description": "Answer a typed relationship question by bounded traversal from authorized seeds, returning explicit depth, fanout and coverage limits instead of an exhaustive graph. edge_kinds is required so that no call can request an untyped walk. A traversal-expanded result set is a bounded candidate pool, not the declared match set.",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "envelope.v1.json#/$defs/request_envelope" },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "envelope.v1.json#/$defs/typed_handle" }
    },
    "edge_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "context_search.v1.json#/$defs/edge_kind" }
    },
    "direction": {
      "type": "string",
      "enum": ["out", "in", "both"],
      "description": "Forward and reverse indexes are maintained separately."
    },
    "max_hops": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 },
    "fanout": { "type": "integer", "minimum": 1, "default": 25 },
    "max_visited_edges": { "type": "integer", "minimum": 1, "default": 200 },
    "filters": {
      "type": "object",
      "properties": {
        "repository_key": { "type": "array", "items": { "type": "string" } },
        "worktree_key": { "type": "array", "items": { "type": "string" } },
        "language": { "type": "array", "items": { "type": "string" } },
        "lifecycle": { "type": "array", "items": { "$ref": "envelope.v1.json#/$defs/lifecycle" } },
        "memory_kinds": { "type": "array", "items": { "$ref": "context_remember.v1.json#/properties/kind" } },
        "resolution_basis": { "type": "array", "items": { "$ref": "#/$defs/resolution_basis" } },
        "source_view": { "$ref": "envelope.v1.json#/$defs/source_view" },
        "commit_oid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" }
      },
      "additionalProperties": false
    },
    "include_unresolved_targets": {
      "type": "boolean",
      "default": true,
      "description": "Unresolved external targets stay explicitly qualified rather than being dropped."
    },
    "diversity": {
      "type": "object",
      "properties": {
        "max_per_node": { "type": "integer", "minimum": 1, "default": 5 },
        "suppress_high_degree_above": { "type": "integer", "minimum": 1, "default": 200 }
      },
      "additionalProperties": false
    },
    "require_source_validation": { "type": "boolean", "default": false },
    "token_budget": { "type": ["integer", "null"], "minimum": 1 },
    "limit": { "type": "integer", "minimum": 1, "default": 25 },
    "cursor": { "type": ["string", "null"], "maxLength": 2048 }
  },
  "required": ["envelope", "seeds", "edge_kinds", "direction"],
  "additionalProperties": false,
  "$defs": {
    "resolution_basis": { "type": "string", "enum": ["syntactic", "convention", "semantic"] },
    "target_resolution": { "type": "string", "enum": ["resolved_local", "unresolved_external", "ambiguous"] },
    "traversal_gap_kind": {
      "type": "string",
      "enum": [
        "unindexed_path", "dirty_path", "resolver_hole", "traversal_budget",
        "unvalidated_source", "host_disconnected", "scope_excluded"
      ]
    }
  }
}
