# frozen_string_literal: true

source "https://rubygems.org"

ruby "3.4.10"

# Rails API-only core. Pinned to the release qualified in Phase 0.
gem "rails", "8.1.3"

# PostgreSQL adapter. Active Record with `pg` is the only ORM (plan 4.2).
gem "pg", "~> 1.6"

# Application server for the `api` service.
gem "puma", "~> 7.0"

# Job transport. Active Job runs on Sidekiq over Redis (plan 4.2, 5.1).
gem "sidekiq", "~> 8.0"

# Official ParadeDB integration for pg_search / BM25 retrieval (plan 5.4).
# 0.12.0 is the release resolved and booted against paradedb/paradedb:0.25.9-pg18
# (pg_search 0.25.9). Pinned here, not only in Gemfile.lock, so `bundle update`
# cannot move the search integration without a deliberate requalification.
gem "rails-paradedb", "0.12.0"

# Ruby 3.4 demoted these from default gems; Rails and its dependencies still
# expect them to be present.
gem "base64", "~> 0.3"
gem "bigdecimal", "~> 3.3"
gem "mutex_m", "~> 0.3"

# json 3.x dropped the second positional argument of JSON.parse, which
# ActiveSupport 8.1.3 still passes (`JSON.parse(source, options)`); an
# unconstrained resolve boots into an ArgumentError before the first test runs.
gem "json", "~> 2.7"

# Boot-time reduction for the container entrypoint.
gem "bootsnap", "~> 1.18", require: false

# Time zone data: the slim runtime image ships no system zoneinfo.
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", "~> 1.11", require: false
end

group :development do
  gem "rubocop", "~> 1.81", require: false
  gem "rubocop-rails", "~> 2.34", require: false
  gem "rubocop-minitest", "~> 0.40", require: false
end

group :test do
  # Rails' default Minitest setup (plan 4.2). Tests run against PostgreSQL.
  gem "minitest", "~> 5.26"
  gem "rails-controller-testing", "~> 1.0"
end
